{
  "name": "poup",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "node scripts/checar-ambiente.mjs web && expo export --platform web",
    "vercel-build": "node scripts/checar-ambiente.mjs web --exigir && expo export --platform web",
    "eas-build-post-install": "node scripts/checar-ambiente.mjs loja --exigir",
    "checar:ambiente": "node scripts/checar-ambiente.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "checar:funcoes": "node scripts/checar-edge-functions.mjs",
    "custo:lia": "node scripts/custo-lia.mjs",
    "testar:financiamento": "node scripts/testar-financiamento.mjs",
    "testar:lia": "node scripts/testar-lia.mjs && node scripts/testar-lia-texto.mjs",
    "testar:acesso-lia": "node scripts/testar-acesso-lia.mjs",
    "testar:limites": "node scripts/testar-limites.mjs",
    "testar:loja": "node scripts/testar-loja.mjs",
    "testar:planos": "node scripts/testar-planos-cadastro.mjs",
    "testar:cobranca": "node scripts/testar-cobranca.mjs",
    "testar:nativo": "node scripts/testar-nativo.mjs",
    "testar:seguranca": "node scripts/testar-seguranca-producao.mjs",
    "testar:apple-web": "node scripts/testar-apple-web.mjs",
    "testar:release": "node scripts/testar-release.mjs",
    "test": "npm run testar:financiamento && npm run testar:lia && npm run testar:acesso-lia && npm run testar:limites && npm run testar:loja && npm run testar:planos && npm run testar:cobranca && npm run testar:nativo && npm run testar:seguranca && npm run testar:apple-web && npm run testar:release",
    "validar:release": "npm run typecheck && npm run lint && npm run checar:funcoes && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-crypto": "15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0"
  },
  "overrides": {
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-config": "0.83.8",
    "metro-core": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@expo/metro-config": {
      "postcss": "8.5.28"
    }
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.3",
    "typescript": "~5.9.2"
  }
}
