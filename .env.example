
# ---------------------------------------------------------------------------

# Supabase (projeto POUP) — pegue em: Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key

# Stripe — chave publicável (pode ser exposta no client)
# Pegue em: Stripe Dashboard > Developers > API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs dos DOIS planos mensais (Stripe Dashboard > Product catalog).
#   Start    R$ 29,90   Pro  R$ 69,90
#
# Estes valores são embutidos no BUILD, não lidos em tempo de execução: mudar a
# variável na Vercel sem redeployar deixa o site publicado com o preço antigo,
# sem nenhum aviso.
#
# Os MESMOS price_... precisam estar nos secrets do Supabase (STRIPE_PRICE_*).
# Configuração divergente, moeda ou valor incorreto bloqueiam o checkout.
# Preço desconhecido no webhook é erro, nunca um downgrade para Start.
#
# Passo a passo completo em docs/STRIPE_PLANOS.md
EXPO_PUBLIC_STRIPE_PRICE_START=price_...
EXPO_PUBLIC_STRIPE_PRICE_PRO=price_...

# URL base do app (usada para redirects de OAuth e Stripe Checkout).
# Local: http://localhost:8081  |  Produção: https://SEU-DOMINIO.vercel.app
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Somente no servidor (Supabase Edge Function Secrets), NUNCA com EXPO_PUBLIC_:
# APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY (.p8), APPLE_CLIENT_ID (bundle iOS)
# APPLE_SERVICES_ID (Services ID web agrupado ao mesmo App ID), APP_URL (HTTPS do site)
# Registrar na Apple o Return URL: https://SEU-PROJETO.supabase.co/functions/v1/apple-link/callback
# Auth redirects do Supabase: URL HTTPS do site/acesso-conta e poup://acesso-conta.
# Vincular outro login exige "Allow manual linking" no Supabase Auth.
# apple-link usa autenticação própria; seu callback Apple exige deploy sem verify_jwt.
